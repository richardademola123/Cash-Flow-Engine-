-- ============================================================
-- Metric Flow Engine V1
-- Model: 12-Week Cashflow Forecast
-- Description: Joins AR and AP models to produce a week-by-week
--              net cashflow view for the next 12 weeks.
-- ============================================================

WITH

-- Step 1: Pull weekly inflow from AR model
ar_weekly AS (
  SELECT
    expected_inflow_week        AS week_starting,
    ROUND(SUM(balance_outstanding), 2) AS expected_inflow
  FROM `your_project.metric_flow_engine.ar_model`
  WHERE expected_inflow_week BETWEEN CURRENT_DATE()
    AND DATE_ADD(CURRENT_DATE(), INTERVAL 12 WEEK)
  GROUP BY week_starting
),

-- Step 2: Pull weekly outflow from AP model
ap_weekly AS (
  SELECT
    week_starting,
    ROUND(SUM(amount), 2)       AS expected_outflow,
    COUNT(*)                    AS payment_count,
    STRING_AGG(supplierName, ', ' ORDER BY supplierName) AS suppliers_due
  FROM `your_project.metric_flow_engine.ap_model`
  WHERE week_starting BETWEEN CURRENT_DATE()
    AND DATE_ADD(CURRENT_DATE(), INTERVAL 12 WEEK)
  GROUP BY week_starting
),

-- Step 3: Generate the 12-week date spine
week_spine AS (
  SELECT
    DATE_TRUNC(
      DATE_ADD(CURRENT_DATE(), INTERVAL week_offset WEEK),
      WEEK(MONDAY)
    ) AS week_starting
  FROM UNNEST(GENERATE_ARRAY(0, 11)) AS week_offset
)

-- Step 4: Join everything together
SELECT
  ws.week_starting,
  COALESCE(ar.expected_inflow, 0)   AS expected_inflow,
  COALESCE(ap.expected_outflow, 0)  AS expected_outflow,

  -- Net position this week
  ROUND(
    COALESCE(ar.expected_inflow, 0) - COALESCE(ap.expected_outflow, 0),
    2
  ) AS net_position,

  -- Cumulative cash position (rolling sum)
  ROUND(
    SUM(
      COALESCE(ar.expected_inflow, 0) - COALESCE(ap.expected_outflow, 0)
    ) OVER (ORDER BY ws.week_starting ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
    2
  ) AS cumulative_cash,

  -- Health flag
  CASE
    WHEN COALESCE(ar.expected_inflow, 0) >= COALESCE(ap.expected_outflow, 0)
    THEN 'Healthy'
    ELSE 'Pressure'
  END AS week_status,

  -- AP context
  COALESCE(ap.payment_count, 0)     AS payments_due,
  COALESCE(ap.suppliers_due, 'None') AS suppliers_due

FROM week_spine ws
LEFT JOIN ar_weekly ar ON ar.week_starting = ws.week_starting
LEFT JOIN ap_weekly ap ON ap.week_starting = ws.week_starting

ORDER BY ws.week_starting ASC;
